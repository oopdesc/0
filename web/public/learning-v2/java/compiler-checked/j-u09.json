.html"}]},"hints":[{"id":"h1","text":"左の値は。","revealsAnswer":false},{"id":"h2","text":"&& の評価規則は。","revealsAnswer":false},{"id":"h3","text":"i++ は実行されるか。","revealsAnswer":false}],"writingRequired":false,"tests":[],"runnerProfile":null,"relatedIds":[],"transferIds":[],"evidence":{"specReviewed":false,"compilerRun":{"tool":"javac/java","version":"javac 21.0.13","sourceSha256":"12ddc7905e11026756d80230dbf408b8379d6abbacce7b062f3b5244c81c9e61","status":"passed","stdout":["0"],"checkedAt":"2026-10-28"},"browserRun":null},"legacyRefs":[],"extensions":{"importedFrom":"01","sourceId":"J0083","verificationScope":"表示コードをラッパー込みで実行し、標準出力を独立照合。解説全文の人手校閲を意味しません。"}},{"id":"java:q20084","language":"java","contentVersion":"independent-20261028","unitId":"java:arena01-J-U09","order":84,"level":"beginner","kind":"choice","title":"複合代入演算子：出力を予測する","prompt":"複合代入演算子：出力を予測する：何を表示する？ コードの結果として正しいものを選んでください。","conceptIds":["java:arena01-j-compound-assignment","java:arena01-j-overflow"],"prerequisiteConceptIds":["java:arena01-j-type","java:arena01-j-primitive"],"introducesConceptIds":[],"setup":{"files":[{"path":"Main.java","content":"byte b = 127;\nb += 1;\nSystem.out.println(b);","editable":false}],"entryPoint":"Main.main","languageVersion":"Java 21","edition":null,"dependencies":[],"note":"mainの本体の抜粋です。標準のjava.util.*などを読み込み、public static void main(String[] args)の中で実行しています。"},"answer":{"mode":"choice","options":[{"id":"d","text":"ArithmeticException"},{"id":"c","text":"コンパイルエラー"},{"id":"b","text":"128"},{"id":"a","text":"-128"}],"correctOptionIds":["a"],"expectedOutput":["-128"],"comparison":"exact-lines","orderItems":[],"correctOrderIds":[]},"solution":{"files":[{"path":"Main.java","content":"byte b = 127;\nb += 1;\nSystem.out.println(b);","editable":false}],"explanation":"b += 1 は b = (byte)(b + 1)。127 + 1 は 128 だが byte に戻すので -128。","reasoningSteps":["b += 1 は b = (byte)(b + 1)。","127 + 1 は 128 だが byte に戻すので -128。"],"wrongReasons":[{"optionId":"b","reason":"byte の範囲は -128〜127。"},{"optio